.edit-page { background: #E8F4F8; min-height: 100vh; padding: 40rpx 32rpx; position: relative; }
.top-right-btn { position: fixed; top: 100rpx; right: 32rpx; background: #C9E5F0; padding: 16rpx 28rpx; border-radius: 60rpx; font-size: 28rpx; font-weight: 600; color: #0077B6; z-index: 10; }
.records-section { background: #FFFFFFE6; border-radius: 56rpx; padding: 36rpx 28rpx; margin-bottom: 60rpx; margin-top: 20rpx; }
.section-title { font-size: 38rpx; font-weight: 700; color: #0077B6; padding-bottom: 24rpx; border-bottom: 2rpx solid #B8D8E8; margin-bottom: 24rpx; }
.records-scroll { max-height: 600rpx; overflow-y: auto; }
.record-item { background: #F0F9FC; border-radius: 40rpx; padding: 28rpx; margin-bottom: 24rpx; border: 1rpx solid #D3E9F0; }
.record-date { font-size: 32rpx; font-weight: 700; color: #0077B6; margin-bottom: 16rpx; }
.record-event { font-size: 30rpx; color: #1E4A62; line-height: 1.4; }
.action-buttons { display: flex; flex-direction: column; gap: 32rpx; margin-bottom: 60rpx; }
.primary-btn, .secondary-btn { padding: 32rpx; border-radius: 80rpx; font-size: 36rpx; font-weight: 600; }
.primary-btn { background: linear-gradient(105deg, #4797B5, #0077B6); color: white; }
.secondary-btn { background: #C9E5F0; color: #0077B6; border: 2rpx solid #A8CFE0; }
.bottom-buttons { display: flex; gap: 24rpx; margin-top: 20rpx; }
.bottom-btn { flex: 1; background: #C9E5F0; color: #2C6E8F; border-radius: 80rpx; font-size: 32rpx; padding: 28rpx 0; margin: 0; border: none; }
.bottom-btn.home { background: #D4EAF2; }