<view class="logs-page">
  <view class="logs-header">📋 全部穿着记录</view>
  <scroll-view scroll-y class="logs-scroll" enhanced show-scrollbar="{{false}}">
    <view wx:if="{{allRecords.length === 0}}" class="empty-logs">✨ 暂无穿着记录，快去添加吧 ✨</view>
    <view wx:for="{{allRecords}}" wx:key="id" class="log-item">
      <view class="log-cloth">{{item.clothName}}</view>
      <view class="log-date">📅 {{item.date}}</view>
      <view class="log-event">{{item.event || '无备注'}}</view>
    </view>
  </scroll-view>
</view>