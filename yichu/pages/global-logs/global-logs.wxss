.logs-page {
    background: #E8F4F8;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    padding: 40rpx 32rpx;
    box-sizing: border-box;
  }
  
  .logs-header {
    font-size: 44rpx;
    font-weight: 700;
    color: #0077B6;
    text-align: center;
    padding-bottom: 40rpx;
    border-bottom: 2rpx solid #B8D8E8;
    margin-bottom: 32rpx;
  }
  
  .logs-scroll {
    flex: 1;
    overflow-y: auto;
    margin-bottom: 40rpx;
  }
  
  .log-item {
    background: #FFFFFFE6;
    border-radius: 48rpx;
    padding: 32rpx;
    margin-bottom: 28rpx;
    border: 1rpx solid #C9E5F0;
    box-shadow: 0 4rpx 12rpx rgba(0,119,182,0.05);
  }
  
  .log-cloth {
    font-size: 34rpx;
    font-weight: 700;
    color: #1E4A62;
    margin-bottom: 12rpx;
  }
  
  .log-date {
    font-size: 28rpx;
    color: #0077B6;
    margin-bottom: 12rpx;
    font-weight: 500;
  }
  
  .log-event {
    font-size: 30rpx;
    color: #4F8BA8;
    line-height: 1.4;
  }
  
  .empty-logs {
    text-align: center;
    padding: 120rpx 0;
    color: #6DA1BD;
    font-size: 36rpx;
    background: #F0F9FC;
    border-radius: 80rpx;
    margin-top: 60rpx;
  }
  
  .bottom-buttons {
    display: flex;
    gap: 24rpx;
    margin-top: 20rpx;
    padding-bottom: 20rpx;
  }
  
  .bottom-btn {
    flex: 1;
    background: #C9E5F0;
    color: #2C6E8F;
    border-radius: 80rpx;
    font-size: 32rpx;
    padding: 28rpx 0;
    margin: 0;
    border: none;
    font-weight: 600;
    transition: all 0.1s ease;
  }
  
  .bottom-btn.home {
    background: #D4EAF2;
  }
  
  .bottom-btn:active {
    transform: scale(0.97);
    opacity: 0.8;
  }