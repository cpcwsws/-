.page {
    display: flex;
    flex-direction: column;
    height: 100vh;
    background: #E8F4F8;
  }
  
  /* 顶部导航栏 - 横向滚动容器 */
  .nav-bar {
    background: #D4EAF2;
    border-bottom: 2rpx solid #B8D8E8;
    padding: 20rpx 0;
  }
  .nav-scroll {
    white-space: nowrap;
    width: 100%;
  }
  .nav-icons {
    display: inline-flex;
    gap: 16rpx;
    padding: 0 24rpx;
  }
  .nav-icon {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    width: 80rpx;
    height: 80rpx;
    font-size: 44rpx;
    background: #FFFFFFCC;
    border-radius: 40rpx;
    color: #2C6E8F;
    font-weight: 600;
    transition: 0.1s;
  }
  .nav-icon:active {
    background: #FFFFFF;
    transform: scale(0.94);
  }
  
  .category-wrapper {
    background: #F0F9FC;
    padding: 20rpx 0 12rpx;
    border-bottom: 1rpx solid #D3E9F0;
  }
  .category-scroll {
    white-space: nowrap;
    height: 96rpx;
  }
  .category-list {
    display: inline-flex;
    padding: 0 24rpx;
    gap: 48rpx;
    align-items: center;
    height: 100%;
  }
  .category-item {
    font-size: 36rpx;
    font-weight: 650;
    color: #4F8BA8;
    padding: 12rpx 8rpx;
    position: relative;
  }
  .category-item.active {
    color: #0077B6;
  }
  .category-item.active::after {
    content: '';
    position: absolute;
    bottom: -8rpx;
    left: 0;
    width: 100%;
    height: 6rpx;
    background: #0077B6;
    border-radius: 6rpx;
  }
  
  .content-scroll {
    flex: 1;
    overflow-y: auto;
    padding: 28rpx 40rpx 40rpx;
  }
  .waterfall {
    display: grid;
    gap: 28rpx;
  }
  .card {
    background: #FFFFFFE6;
    border-radius: 48rpx;
    overflow: hidden;
    box-shadow: 0 8rpx 20rpx rgba(0,119,182,0.1);
    border: 1rpx solid #C9E5F0;
  }
  .card-img-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    background: #D4EAF2;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .card-img {
    width: 100%;
    height: 100%;
  }
  .card-img-placeholder {
    font-size: 36rpx;
    color: #4F8BA8;
    text-align: center;
    word-break: break-all;
    padding: 20rpx;
  }
  .wear-count-badge {
    position: absolute;
    top: 20rpx;
    left: 20rpx;
    background: rgba(0,119,182,0.85);
    backdrop-filter: blur(8px);
    color: white;
    font-size: 26rpx;
    font-weight: 600;
    padding: 10rpx 24rpx;
    border-radius: 60rpx;
  }
  .card-info {
    padding: 24rpx 20rpx 30rpx;
  }
  .card-title {
    font-size: 32rpx;
    font-weight: 600;
    color: #1E4A62;
    display: block;
    line-height: 1.4;
  }
  .card-price {
    font-size: 28rpx;
    color: #0077B6;
    margin-top: 12rpx;
    display: block;
  }
  .empty-placeholder {
    text-align: center;
    padding: 120rpx 0;
    color: #6DA1BD;
    font-size: 36rpx;
    background: #F0F9FC;
    border-radius: 80rpx;
    margin-top: 60rpx;
  }