.record-page { padding: 60rpx 40rpx; background: #E8F4F8; min-height: 100vh; }
.date-picker { background: #FFFFFF; padding: 32rpx; border-radius: 56rpx; margin-bottom: 56rpx; font-size: 36rpx; color: #1E4A62; font-weight: 600; border: 2rpx solid #B8D8E8; }
.event-input { width: 100%; background: #FFFFFF; border-radius: 56rpx; padding: 32rpx; min-height: 280rpx; margin-bottom: 56rpx; font-size: 36rpx; color: #1E4A62; border: 2rpx solid #B8D8E8; }
.photo-upload { margin-bottom: 80rpx; }
.upload-box, .photo-preview { width: 100%; height: 400rpx; background: #DCF2F9; border-radius: 64rpx; display: flex; align-items: center; justify-content: center; color: #4F8BA8; font-size: 36rpx; border: 3rpx dashed #87C4E2; }
.photo-preview { object-fit: cover; border: 2rpx solid #A8CFE0; }
.save-record { background: linear-gradient(105deg, #4797B5, #0077B6); color: white; border-radius: 80rpx; margin-bottom: 32rpx; font-size: 40rpx; padding: 36rpx 0; border: none; }
.back-btn { background: #C9E5F0; color: #2C6E8F; border-radius: 80rpx; font-size: 40rpx; padding: 36rpx 0; border: 1rpx solid #A8CFE0; margin-bottom: 40rpx; }
.bottom-buttons { display: flex; gap: 24rpx; margin-top: 20rpx; }
.bottom-btn { flex: 1; background: #C9E5F0; color: #2C6E8F; border-radius: 80rpx; font-size: 32rpx; padding: 28rpx 0; margin: 0; border: none; }
.bottom-btn.home { background: #D4EAF2; }